# Copy to .env and fill in. NEVER commit .env. Testnet / sandbox keys only.

# Ledger: fisco = local FISCO BCOS 3.x chain, evm = Base Sepolia fallback
LEDGER_TARGET=evm
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
ADMIN_PRIVATE_KEY=
COORDINATOR_PRIVATE_KEY=

# Human approvers (EIP-712 signers). Demo only: held server-side.
SUPPLIER_SIGNER_KEY=
BUYER_SIGNER_KEY=

# Bank sandbox (simulated). The webhook HMAC secret is shared by the bank sandbox and the coordinator.
BANK_WEBHOOK_SECRET=
BANK_URL=http://127.0.0.1:8300
BANK_WEBHOOK_URL=http://127.0.0.1:8200/webhooks/bank
BANK_STEP_SECONDS=2
BANK_FAIL_RATE=0
BANK_ADMIN_TOKEN=

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# offline = deterministic strategies, no API calls; online = Anthropic API
LLM_MODE=offline

# Optimizer: allow settling only part of an invoice early
ALLOW_PARTIAL=true
