# Copy to .env and fill in. NEVER commit .env. Testnet / sandbox keys only.

# Ledger: evm = Base Sepolia (or local anvil, CHAIN_ID=31337), fisco = FISCO BCOS 3.x
# (local chain via Web3 RPC: RPC_URL=http://127.0.0.1:8545 CHAIN_ID=20200, see `make fisco-up`),
# none = ledger disabled (writes return no tx hash; nothing is presented as on-chain)
LEDGER_TARGET=evm
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
ADMIN_PRIVATE_KEY=
COORDINATOR_PRIVATE_KEY=

# Human approvers (EIP-712 signers). Demo only: held server-side.
# Any key left empty falls back to a PUBLIC anvil test key (local/test chains only).
SUPPLIER_SIGNER_KEY=
BUYER_SIGNER_KEY=

# Bank sandbox (simulated). The webhook HMAC secret is shared by the bank sandbox and the coordinator.
BANK_WEBHOOK_SECRET=
BANK_URL=http://127.0.0.1:8300
BANK_WEBHOOK_URL=http://127.0.0.1:8200/webhooks/bank
BANK_STEP_SECONDS=2
BANK_FAIL_RATE=0
BANK_ADMIN_TOKEN=

# Service URLs (defaults match `make up`)
SUPPLIER_URL=http://127.0.0.1:8101
BUYER_URL=http://127.0.0.1:8102
COORDINATOR_URL=http://127.0.0.1:8200

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# offline = deterministic strategies, no API calls; online = Anthropic API
LLM_MODE=offline
# Online provider: anthropic (uses ANTHROPIC_API_KEY, LLM_MODEL) or groq (OpenAI-compatible API)
LLM_PROVIDER=anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optimizer: allow settling only part of an invoice early
ALLOW_PARTIAL=true
